# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# ---------------------------------------------------------------------------
# Local model (LM Studio / any OpenAI-compatible server)
# ---------------------------------------------------------------------------
# Point JARVIS at a model running on your own machine instead of the Anthropic
# API. See docs/LOCAL_MODEL.md. Verify a configuration with:
#     python llm_provider.py --check
#
# anthropic | local | auto   ("auto" = local when LOCAL_LLM_MODEL is set)
# LLM_PROVIDER=auto
#
# LM Studio's default endpoint. The /v1 suffix is required.
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
#
# Must match an id from GET /v1/models exactly — quantization suffix included.
# `lms ps` lists what is loaded.
# LOCAL_LLM_MODEL=kimi-k2-instruct
#
# Optional second model for research turns. Defaults to LOCAL_LLM_MODEL.
# LOCAL_LLM_DEEP_MODEL=
#
# LM Studio ignores the key's value but the header must be present.
# LOCAL_LLM_API_KEY=lm-studio
#
# Local models on modest hardware can be slow; raise if you see timeouts.
# LOCAL_LLM_TIMEOUT=120

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com
